{
  "name": "core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.16.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @realms-world/account-portal dev",
    "build": "pnpm --filter @realms-world/account-portal build && pnpm --filter @realms-world/apibara build",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "smoke": "pnpm --filter @realms-world/account-portal smoke:production",
    "apibara:start": "pnpm --filter @realms-world/apibara start",
    "apibara:build": "pnpm --filter @realms-world/apibara build",
    "db:push": "pnpm --filter @realms-world/db with-env drizzle-kit push",
    "db:pull": "pnpm --filter @realms-world/db with-env drizzle-kit pull",
    "db:migrate": "pnpm --filter @realms-world/db migrate",
    "lint": "pnpm --recursive run lint"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@eslint/js": "^9.39.2",
    "@realms-world/eslint-config": "workspace:*",
    "@realms-world/prettier-config": "workspace:*",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript-eslint": "^8.55.0"
  },
  "prettier": "@realms-world/prettier-config",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "bufferutil",
      "cbor-extract",
      "esbuild",
      "protobufjs",
      "utf-8-validate"
    ],
    "onlyBuiltDependencies": [
      "@reown/appkit"
    ],
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.6",
      "@grpc/grpc-js@>=1.14.0 <1.14.4": "1.14.4",
      "@tanstack/start-server-core>h3-v2": "npm:h3@2.0.1-rc.25",
      "axios@>=1.0.0 <1.18.1": "1.18.1",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=4.0.0 <5.0.6": "5.0.6",
      "defu@<=6.1.4": "6.1.7",
      "esbuild@<=0.24.2": "0.25.12",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "flatted@<3.4.2": "3.4.2",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "h3@<1.15.6": "1.15.11",
      "h3@>=2.0.0-0 <2.0.1-rc.15": "2.0.1-rc.25",
      "jayson>uuid": "11.1.1",
      "js-yaml@>=4.0.0 <=4.1.1": "4.2.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.5": "4.0.5",
      "protobufjs@<7.6.5": "7.6.5",
      "postcss@<8.5.10": "8.5.10",
      "rpc-websockets>uuid": "11.1.1",
      "starknet": "^9.2.1",
      "tar@<7.5.19": "7.5.19",
      "undici@>=7.0.0 <7.28.0": "7.28.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "yaml@>=2.0.0 <2.8.3": "2.8.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@apibara/indexer>vitest": "4.1.10",
        "isomorphic-ws>ws": ">=7.5.11",
        "isows>ws": ">=7.5.11"
      }
    }
  },
  "workspaces": {
    "packages": [
      "./apps/**",
      "./packages/**",
      "./tooling/**"
    ],
    "catalog": {
      "eslint": "^9.39.2",
      "prettier": "^3.8.1",
      "zod": "^3.25.76",
      "dotenv-cli": "^7.4.4",
      "starknet": "^9.2.1",
      "viem": "^2.45.3",
      "drizzle-kit": "^0.31.9",
      "drizzle-orm": "0.45.2",
      "typescript": "^5.9.3"
    }
  }
}
