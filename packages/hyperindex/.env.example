# Supply these directly to the Railway worker, never as VITE_* variables.
ENVIO_CONFIG=config.mainnet.yaml
ENVIO_API_TOKEN=
ENVIO_PG_HOST=
ENVIO_PG_PORT=5432
ENVIO_PG_DATABASE=
ENVIO_PG_USER=
ENVIO_PG_PASSWORD=
ENVIO_PG_SCHEMA=hyperindex_l1_mainnet
ENVIO_PG_SSL_MODE=verify-full
ENVIO_HASURA=false
ENVIO_TUI=false
# Railway supplies PORT; bootstrap maps it to ENVIO_INDEXER_PORT.
