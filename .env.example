# Public runtime configuration
VITE_PUBLIC_CHAIN=mainnet
VITE_PUBLIC_SLOT=eternum-prod
VITE_BASE_URL=http://localhost:3000

VITE_PUBLIC_IMAGE_CDN_URL=https://media.arkproject.dev
VITE_PUBLIC_IMAGE_PROXY_URL=https://imgproxy.arkproject.dev
VITE_PUBLIC_IPFS_GATEWAY=https://ipfs.arkproject.dev/ipfs/
# Required: use the active Torii deployment for the selected chain.
VITE_TORII_API_URL=https://api.cartridge.gg/x/replace-with-active-deployment/torii
VITE_PUBLIC_NODE_URL=

# Server-only configuration. Never prefix secrets with VITE_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ALCHEMY_API_KEY=replace-with-alchemy-api-key
ETHPLORER_API_KEY=
