{
  "name": "@realms-world/account-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env vite dev",
    "build": "pnpm with-env vite build && node scripts/bundle-budget.js",
    "codegen": "pnpm codegen:snapshot && pnpm codegen:eternum",
    "codegen:eternum": "pnpm with-env env CODEGEN_TARGET=eternum graphql-codegen --config codegen.ts",
    "codegen:snapshot": "env CODEGEN_TARGET=snapshot graphql-codegen --config codegen.ts",
    "lint": "eslint",
    "smoke:production": "pnpm with-env node scripts/smoke-production.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "pnpm with-env vite start",
    "with-env": "dotenv -e ../../.env --"
  },
